Attribute VB_Name = "Mod_TestGen_Assembler"
Option Explicit
' Включает обязательное объявление переменных.
' Если где-то опечататься в имени переменной — VBA сразу выдаст ошибку.

' ============================================================
' ГЕНЕРАТОР ТЕСТОВЫХ ДАННЫХ ДЛЯ MOD_ASSEMBLER
' Создает файлы шагов с типами и атрибутами, включая ошибки.
' Имена файлов соответствуют маске Mod_Assembler: *_types.xlsx / *_attributes.xlsx
' ============================================================

Public Sub GenerateTestAssemblerSteps()
    ' Главная процедура. Запускается из Alt+F8 или кнопкой.
    ' Создаёт файлы Excel для ДВУХ папок шагов:
    '   Шаг_00_Скелет:        step_00_types.xlsx, step_00_attributes.xlsx
    '   Шаг_01_Универсальные: step_01_types.xlsx, step_01_attributes.xlsx
    ' Данные содержат как корректные строки, так и специально
    ' встроенные ошибки для проверки Mod_Assembler.

    Dim root As String
    ' Переменная для пути к корневой папке проекта (например, C:\Проект_Pilot\test).

    Dim stepPath As String
    ' Переменная для пути к папке Шага 0 (куда сложатся созданные файлы этого шага).

    Dim stepPath2 As String
    ' Переменная для пути к папке Шага 1 (вторая папка для проверки слияния данных).

    Dim wb As Workbook
    ' Переменная для новой книги Excel (создаём её временно).

    Dim ws As Worksheet
    ' Переменная для листа внутри новой книги.

    Application.ScreenUpdating = False
    ' Отключаем обновление экрана. Так книга создаётся быстрее,
    ' и пользователь не видит мигания окон.

    Application.DisplayAlerts = False
    ' Отключаем системные предупреждения Excel.
    ' Например, «Сохранить файл?» при закрытии.

    root = Mod_Util.GetProjectRoot
    ' Получаем путь к корню проекта через служебную процедуру Mod_Util.

    If root = "" Then
        ' Проверка: если корень не задан (пустая строка) — работать некуда.
        MsgBox "Не задан корень проекта (ProjectRoot).", vbCritical
        ' Показываем сообщение об ошибке.
        Exit Sub
        ' Выходим из процедуры, ничего не создаём.
    End If
    ' Конец проверки корня.

    ' Путь к папке Шага 0 (как ожидает Mod_Assembler)
    stepPath = root & "\03_Результаты генерации\01_По шагам\Шаг_00_Скелет"

    ' Путь к папке Шага 1 (вторая папка — проверка слияния нескольких шагов)
    stepPath2 = root & "\03_Результаты генерации\01_По шагам\Шаг_01_Универсальные"

    ' Создаем всю цепочку папок по одной, если их нет
    Dim p1 As String, p2 As String, p3 As String
    ' p1/p2 — общие родительские папки для обоих шагов,
    ' p3 — папка конкретного шага (переиспользуется для Шага 0 и Шага 1).
    p1 = root & "\03_Результаты генерации"
    ' Первая папка дерева — результаты генерации.

    p2 = p1 & "\01_По шагам"
    ' Вторая папка — подпапка с разбивкой по шагам.

    p3 = p2 & "\Шаг_00_Скелет"
    ' Третья папка — непосредственно папка Шага 0.

    If Dir(p1, vbDirectory) = "" Then MkDir p1
    ' Если папка не существует (Dir пустой) — создаём её.
    ' Ошибка возможна, если нет прав на запись или диск недоступен.

    If Dir(p2, vbDirectory) = "" Then MkDir p2
    ' Аналогично создаём вторую папку цепочки.

    If Dir(p3, vbDirectory) = "" Then MkDir p3
    ' И папку Шага 0.
    ' Конец проверки/создания папки.

    ' ============================================================
    ' 1. СОЗДАНИЕ ФАЙЛА ТИПОВ (step_00_types.xlsx)
    ' ============================================================

    Set wb = Workbooks.Add
    ' Создаём новую книгу Excel (по умолчанию с одним листом).

    Set ws = wb.Sheets(1)
    ' Берём первый лист новой книги.

    ' Заголовки (строго по спецификации Mod_Assembler)
    ws.Range("A1:L1").value = Array("Системное имя типа", "Видимое имя типа", "Может быть корневым", _
                                    "Может монтироваться", "Отображается на диске", "Является проектом", _
                                    "Является документом", "Умные папки", "Служебный", "Доп. параметры", _
                                    "Состоит из", "Входит в")
    ' Записываем в первую строку 12 заголовков колонок.
    ' Mod_Assembler ожидает именно такие заголовки.
    ' Если хоть один заголовок изменить — валидатор не сможет прочитать файл.

    ' Строка 2: Корректный тип (Папка)
    ws.Cells(2, 1).value = "test_folder"
    ' Системное имя типа (camelCase).
    ws.Cells(2, 2).value = "Тестовая папка"
    ' Видимое имя на русском.
    ws.Cells(2, 3).value = "нет"
    ' Может быть корневым.
    ws.Cells(2, 4).value = "нет"
    ' Может монтироваться.
    ws.Cells(2, 5).value = "нет"
    ' Отображается на диске.
    ws.Cells(2, 6).value = "нет"
    ' Является проектом.
    ws.Cells(2, 7).value = "нет"
    ' Является документом (папка — не документ).
    ws.Cells(2, 8).value = "нет"
    ' Умные папки.
    ws.Cells(2, 9).value = "нет"
    ' Служебный.
    ws.Cells(2, 11).value = "test_doc; test_doc_bad"
    ' Состоит из: перечисляем детей через "; ".
    ws.Cells(2, 12).value = "object"
    ' Входит в: родитель — корень "object".
    ' Эта строка должна пройти валидацию без ошибок.

    ' Строка 3: Корректный тип (Документ)
    ws.Cells(3, 1).value = "test_doc"
    ' Системное имя типа.
    ws.Cells(3, 2).value = "Тестовый документ"
    ' Видимое имя.
    ws.Cells(3, 3).value = "нет"
    ' Может быть корневым.
    ws.Cells(3, 4).value = "нет"
    ' Может монтироваться.
    ws.Cells(3, 5).value = "нет"
    ' Отображается на диске.
    ws.Cells(3, 6).value = "нет"
    ' Является проектом.
    ws.Cells(3, 7).value = "да"
    ' Является документом (да — сработает проверка T009).
    ws.Cells(3, 8).value = "нет"
    ' Умные папки.
    ws.Cells(3, 9).value = "нет"
    ' Служебный.
    ws.Cells(3, 11).value = "doc_remarksFolder"
    ' Состоит из: у документов ОБЯЗАТЕЛЬНО должен быть doc_remarksFolder.
    ws.Cells(3, 12).value = "test_folder"
    ' Входит в: родитель — папка test_folder.
    ' Эта строка — эталон корректного документа.

    ' Строка 4: ОШИБКА 1 (T009 - Документ без doc_remarksFolder)
    ws.Cells(4, 1).value = "test_doc_bad"
    ' Системное имя.
    ws.Cells(4, 2).value = "Плохой документ"
    ' Видимое имя.
    ws.Cells(4, 3).value = "нет"
    ' Может быть корневым.
    ws.Cells(4, 4).value = "нет"
    ' Может монтироваться.
    ws.Cells(4, 5).value = "нет"
    ' Отображается на диске.
    ws.Cells(4, 6).value = "нет"
    ' Является проектом.
    ws.Cells(4, 7).value = "да"
    ' Является документом.
    ws.Cells(4, 8).value = "нет"
    ' Умные папки.
    ws.Cells(4, 9).value = "нет"
    ' Служебный.
    ws.Cells(4, 11).value = ""
    ' ОШИБКА: "Состоит из" пустое, хотя это документ.
    ' Валидатор должен выдать код T009.
    ws.Cells(4, 12).value = "test_folder"
    ' Входит в: родитель корректный.

    ' Строка 5: ОШИБКА 2 (T016 - Пустое видимое имя)
    ws.Cells(5, 1).value = "test_empty_name"
    ' Системное имя (корректное).
    ws.Cells(5, 2).value = ""
    ' ОШИБКА: пустое видимое имя.
    ' Валидатор должен выдать код T016.
    ws.Cells(5, 3).value = "нет"
    ' Может быть корневым.
    ws.Cells(5, 4).value = "нет"
    ' Может монтироваться.
    ws.Cells(5, 5).value = "нет"
    ' Отображается на диске.
    ws.Cells(5, 6).value = "нет"
    ' Является проектом.
    ws.Cells(5, 7).value = "нет"
    ' Является документом.
    ws.Cells(5, 8).value = "нет"
    ' Умные папки.
    ws.Cells(5, 9).value = "нет"
    ' Служебный.
    ws.Cells(5, 11).value = ""
    ' Состоит из (пусто, для папки это норма).
    ws.Cells(5, 12).value = "test_folder"
    ' Входит в: родитель корректный.

    ' Строка 6: ОШИБКА 3 (T002 - camelCase нарушение)
    ws.Cells(6, 1).value = "Test_Bad_Name"
    ' ОШИБКА: заглавная первая буква, подчёркивания.
    ' Валидатор должен выдать код T002.
    ws.Cells(6, 2).value = "Плохое имя типа"
    ' Видимое имя.
    ws.Cells(6, 3).value = "нет"
    ' Может быть корневым.
    ws.Cells(6, 4).value = "нет"
    ' Может монтироваться.
    ws.Cells(6, 5).value = "нет"
    ' Отображается на диске.
    ws.Cells(6, 6).value = "нет"
    ' Является проектом.
    ws.Cells(6, 7).value = "нет"
    ' Является документом.
    ws.Cells(6, 8).value = "нет"
    ' Умные папки.
    ws.Cells(6, 9).value = "нет"
    ' Служебный.
    ws.Cells(6, 11).value = ""
    ' Состоит из.
    ws.Cells(6, 12).value = "test_folder"
    ' Входит в: родитель корректный.

    wb.SaveAs fileName:=stepPath & "\step_00_types.xlsx", FileFormat:=xlOpenXMLWorkbook
    ' Сохраняем созданную книгу с типами в папку шага.
    ' Имя файла исправлено: было types_step_00.xlsx, стало step_00_types.xlsx —
    ' теперь файл попадает под маску *_types.xlsx, которую ищет Mod_Assembler.
    ' FileFormat:=xlOpenXMLWorkbook — формат .xlsx (обычный Excel).
    ' Возможная ошибка: файл открыт другим процессом — SaveAs упадёт с ошибкой доступа.

    wb.Close SaveChanges:=False
    ' Закрываем книгу. SaveChanges:=False — не спрашивать «Сохранить?»
    ' (мы уже сохранили).

    ' ============================================================
    ' 2. СОЗДАНИЕ ФАЙЛА АТРИБУТОВ (step_00_attributes.xlsx)
    ' ============================================================

    Set wb = Workbooks.Add
    ' Создаём ещё одну новую книгу для атрибутов.

    Set ws = wb.Sheets(1)
    ' Берём первый лист.

    ' Заголовки
    ws.Range("A1:L1").value = Array("Системное имя типа", "name", "Наименование", _
                                    "Группа", "Тип атрибута", "В названиях", _
                                    "Не индексировать", "Обязательный", "Объединять", _
                                    "Служебный", "Уникальность", "Доп. параметры")
    ' Записываем 12 заголовков для файла атрибутов.
    ' Mod_Assembler ожидает именно такие названия колонок.

    ' Строка 2: Корректный атрибут
    ws.Cells(2, 1).value = "test_folder"
    ' Системное имя типа, к которому относится атрибут.
    ws.Cells(2, 2).value = "attrString"
    ' Имя атрибута (camelCase).
    ws.Cells(2, 3).value = "Тестовая строка"
    ' Видимое имя на русском.
    ws.Cells(2, 4).value = "Общие"
    ' Группа атрибутов (должна содержать 2 атрибутов).
    ws.Cells(2, 5).value = "Строка"
    ' Тип атрибута (из списка myAdmin).
    ws.Cells(2, 6).value = "да"
    ' В названиях.
    ws.Cells(2, 7).value = "нет"
    ' Не индексировать.
    ws.Cells(2, 8).value = "нет"
    ' Обязательный.
    ws.Cells(2, 9).value = "нет"
    ' Объединять.
    ws.Cells(2, 10).value = "нет"
    ' Служебный.
    ws.Cells(2, 11).value = "Не проверять"
    ' Уникальность (одно из трёх значений).
    ws.Cells(2, 12).value = ""
    ' Доп. параметры (XML, пусто — допустимо).
    ' Эта строка должна пройти валидацию.

    ' Строка 3: Корректный атрибут
    ws.Cells(3, 1).value = "test_folder"
    ' Тип.
    ws.Cells(3, 2).value = "attrDate"
    ' Имя атрибута.
    ws.Cells(3, 3).value = "Тестовая дата"
    ' Видимое имя.
    ws.Cells(3, 4).value = "Общие"
    ' Группа (та же, что у attrString — теперь группа содержит 2 атрибута, ошибки A009 не будет).
    ws.Cells(3, 5).value = "Дата и время"
    ' Тип атрибута.
    ws.Cells(3, 6).value = "нет"
    ' В названиях.
    ws.Cells(3, 7).value = "нет"
    ' Не индексировать.
    ws.Cells(3, 8).value = "да"
    ' Обязательный.
    ws.Cells(3, 9).value = "нет"
    ' Объединять.
    ws.Cells(3, 10).value = "нет"
    ' Служебный.
    ws.Cells(3, 11).value = "Не проверять"
    ' Уникальность.
    ws.Cells(3, 12).value = ""
    ' Доп. параметры.

    ' Строка 4: ОШИБКА 1 (A006 - Неверный тип атрибута)
    ws.Cells(4, 1).value = "test_folder"
    ' Тип.
    ws.Cells(4, 2).value = "attrBadType"
    ' Имя атрибута.
    ws.Cells(4, 3).value = "Плохой тип атрибута"
    ' Видимое имя.
    ws.Cells(4, 4).value = ""
    ' Группа (пусто).
    ws.Cells(4, 5).value = "String (Bad)"
    ' ОШИБКА: тип атрибута не из списка myAdmin.
    ' Валидатор должен выдать код A006.
    ws.Cells(4, 6).value = "нет"
    ' В названиях.
    ws.Cells(4, 7).value = "нет"
    ' Не индексировать.
    ws.Cells(4, 8).value = "нет"
    ' Обязательный.
    ws.Cells(4, 9).value = "нет"
    ' Объединять.
    ws.Cells(4, 10).value = "нет"
    ' Служебный.
    ws.Cells(4, 11).value = "Не проверять"
    ' Уникальность.
    ws.Cells(4, 12).value = ""
    ' Доп. параметры.

    ' Строка 5: ОШИБКА 2 (A001 - Несуществующий тип)
    ws.Cells(5, 1).value = "test_no_type"
    ' ОШИБКА: такого типа нет в step_00_types.xlsx.
    ' Валидатор должен выдать код A001.
    ws.Cells(5, 2).value = "attrOrphan"
    ' Имя атрибута.
    ws.Cells(5, 3).value = "Атрибут сироты"
    ' Видимое имя.
    ws.Cells(5, 4).value = ""
    ' Группа.
    ws.Cells(5, 5).value = "Строка"
    ' Тип атрибута.
    ws.Cells(5, 6).value = "нет"
    ' В названиях.
    ws.Cells(5, 7).value = "нет"
    ' Не индексировать.
    ws.Cells(5, 8).value = "нет"
    ' Обязательный.
    ws.Cells(5, 9).value = "нет"
    ' Объединять.
    ws.Cells(5, 10).value = "нет"
    ' Служебный.
    ws.Cells(5, 11).value = "Не проверять"
    ' Уникальность.
    ws.Cells(5, 12).value = ""
    ' Доп. параметры.

    ' Строка 6: ОШИБКА 3 (A003 - Имя атрибута не camelCase)
    ws.Cells(6, 1).value = "test_folder"
    ' Тип (корректный).
    ws.Cells(6, 2).value = "Attr_Bad_Name"
    ' ОШИБКА: заглавная первая буква, подчёркивания.
    ' Валидатор должен выдать код A003.
    ws.Cells(6, 3).value = "Плохое имя атрибута"
    ' Видимое имя.
    ws.Cells(6, 4).value = ""
    ' Группа.
    ws.Cells(6, 5).value = "Строка"
    ' Тип атрибута.
    ws.Cells(6, 6).value = "нет"
    ' В названиях.
    ws.Cells(6, 7).value = "нет"
    ' Не индексировать.
    ws.Cells(6, 8).value = "нет"
    ' Обязательный.
    ws.Cells(6, 9).value = "нет"
    ' Объединять.
    ws.Cells(6, 10).value = "нет"
    ' Служебный.
    ws.Cells(6, 11).value = "Не проверять"
    ' Уникальность.
    ws.Cells(6, 12).value = ""
    ' Доп. параметры.

    wb.SaveAs fileName:=stepPath & "\step_00_attributes.xlsx", FileFormat:=xlOpenXMLWorkbook
    ' Сохраняем файл атрибутов в папку шага.
    ' Имя файла исправлено: было attributes_step_00.xlsx, стало step_00_attributes.xlsx.

    wb.Close SaveChanges:=False
    ' Закрываем книгу.

    ' ============================================================
    ' 3. СОЗДАНИЕ ПАПКИ ШАГА 1 (Шаг_01_Универсальные)
    '    Нужна, чтобы проверить слияние данных из нескольких папок.
    ' ============================================================

    ' Создаём папку Шага 1, переиспользуя те же переменные p1, p2, p3,
    ' что и для Шага 0 (p1 и p2 уже существуют, меняем только p3).
    p3 = p2 & "\Шаг_01_Универсальные"
    ' Теперь p3 указывает на папку второго шага.

    If Dir(p3, vbDirectory) = "" Then MkDir p3
    ' Если папка Шага 1 отсутствует — создаём её.

    ' ============================================================
    ' 4. СОЗДАНИЕ ФАЙЛА ТИПОВ ШАГА 1 (step_01_types.xlsx)
    ' ============================================================

    Set wb = Workbooks.Add
    ' Создаём новую книгу Excel для типов второго шага.

    Set ws = wb.Sheets(1)
    ' Берём первый лист новой книги.

    ' Заголовки (те же 12 колонок, что и в Шаге 0)
    ws.Range("A1:L1").value = Array("Системное имя типа", "Видимое имя типа", "Может быть корневым", _
                                    "Может монтироваться", "Отображается на диске", "Является проектом", _
                                    "Является документом", "Умные папки", "Служебный", "Доп. параметры", _
                                    "Состоит из", "Входит в")
    ' Записываем в первую строку 12 заголовков колонок.
    ' Набор заголовков идентичен Шагу 0 — иначе Mod_Assembler не прочитает файл.

    ' Строка 2: Корректный тип (Универсальная папка)
    ws.Cells(2, 1).value = "test_universal_1"
    ' Системное имя типа (корректное camelCase-подобное имя теста).
    ws.Cells(2, 2).value = "Универсальная папка 1"
    ' Видимое имя на русском.
    ws.Cells(2, 3).value = "нет"
    ' Может быть корневым.
    ws.Cells(2, 4).value = "нет"
    ' Может монтироваться.
    ws.Cells(2, 5).value = "нет"
    ' Отображается на диске.
    ws.Cells(2, 6).value = "нет"
    ' Является проектом.
    ws.Cells(2, 7).value = "нет"
    ' Является документом (папка — не документ).
    ws.Cells(2, 8).value = "нет"
    ' Умные папки.
    ws.Cells(2, 9).value = "нет"
    ' Служебный.
    ws.Cells(2, 11).value = ""
    ' Состоит из (пусто, для папки это норма).
    ws.Cells(2, 12).value = "test_folder"
    ' Входит в: родитель — тип из Шага 0 (проверка кросс-ссылок между папками).
    ' Эта строка должна пройти валидацию без ошибок.

    ' Строка 3: Корректный тип (Универсальный документ)
    ws.Cells(3, 1).value = "test_universal_2"
    ' Системное имя типа.
    ws.Cells(3, 2).value = "Универсальный документ 2"
    ' Видимое имя.
    ws.Cells(3, 3).value = "нет"
    ' Может быть корневым.
    ws.Cells(3, 4).value = "нет"
    ' Может монтироваться.
    ws.Cells(3, 5).value = "нет"
    ' Отображается на диске.
    ws.Cells(3, 6).value = "нет"
    ' Является проектом.
    ws.Cells(3, 7).value = "да"
    ' Является документом.
    ws.Cells(3, 8).value = "нет"
    ' Умные папки.
    ws.Cells(3, 9).value = "нет"
    ' Служебный.
    ws.Cells(3, 11).value = "doc_remarksFolder"
    ' Состоит из: у документа ОБЯЗАТЕЛЬНО должен быть doc_remarksFolder —
    ' иначе валидатор выдаст ошибку T009.
    ws.Cells(3, 12).value = "test_universal_1"
    ' Входит в: родитель — тип из этой же папки Шага 1.
    ' Эта строка — эталон корректного документа второго шага.

    wb.SaveAs fileName:=stepPath2 & "\step_01_types.xlsx", FileFormat:=xlOpenXMLWorkbook
    ' Сохраняем книгу с типами Шага 1 во вторую папку.
    ' Имя файла соответствует маске *_types.xlsx, поэтому Mod_Assembler
    ' подхватит его при загрузке всех папок шагов.

    wb.Close SaveChanges:=False
    ' Закрываем книгу без лишних вопросов о сохранении.

    ' ============================================================
    ' 5. СОЗДАНИЕ ФАЙЛА АТРИБУТОВ ШАГА 1 (step_01_attributes.xlsx)
    ' ============================================================

    Set wb = Workbooks.Add
    ' Создаём новую книгу Excel для атрибутов второго шага.

    Set ws = wb.Sheets(1)
    ' Берём первый лист новой книги.

    ' Заголовки (те же 12 колонок, что и в Шаге 0)
    ws.Range("A1:L1").value = Array("Системное имя типа", "name", "Наименование", _
                                    "Группа", "Тип атрибута", "В названиях", _
                                    "Не индексировать", "Обязательный", "Объединять", _
                                    "Служебный", "Уникальность", "Доп. параметры")
    ' Записываем 12 заголовков для файла атрибутов.
    ' Mod_Assembler ожидает именно такие названия колонок.

    ' Строка 2: Корректный атрибут для test_universal_1
    ws.Cells(2, 1).value = "test_universal_1"
    ' Системное имя типа из step_01_types.xlsx (иначе будет ошибка A001).
    ws.Cells(2, 2).value = "attrUniversal1"
    ' Имя атрибута (camelCase).
    ws.Cells(2, 3).value = "Универсальный атрибут 1"
    ' Видимое имя на русском.
    ws.Cells(2, 4).value = "Универсальные"
    ' Группа атрибутов.
    ws.Cells(2, 5).value = "Строка"
    ' Тип атрибута (из списка myAdmin).
    ws.Cells(2, 6).value = "нет"
    ' В названиях.
    ws.Cells(2, 7).value = "нет"
    ' Не индексировать.
    ws.Cells(2, 8).value = "нет"
    ' Обязательный.
    ws.Cells(2, 9).value = "нет"
    ' Объединять.
    ws.Cells(2, 10).value = "нет"
    ' Служебный.
    ws.Cells(2, 11).value = "Не проверять"
    ' Уникальность (одно из трёх значений).
    ws.Cells(2, 12).value = ""
    ' Доп. параметры (пусто — допустимо).
    ' Эта строка должна пройти валидацию без ошибок.

    ' Строка 3: Корректный атрибут для test_universal_2
    ws.Cells(3, 1).value = "test_universal_2"
    ' Системное имя типа из step_01_types.xlsx.
    ws.Cells(3, 2).value = "attrUniversal2"
    ' Имя атрибута (camelCase).
    ws.Cells(3, 3).value = "Универсальный атрибут 2"
    ' Видимое имя на русском.
    ws.Cells(3, 4).value = "Универсальные"
    ' Группа атрибутов (та же, что выше — группа содержит 2 атрибута).
    ws.Cells(3, 5).value = "Строка"
    ' Тип атрибута (из списка myAdmin).
    ws.Cells(3, 6).value = "нет"
    ' В названиях.
    ws.Cells(3, 7).value = "нет"
    ' Не индексировать.
    ws.Cells(3, 8).value = "нет"
    ' Обязательный.
    ws.Cells(3, 9).value = "нет"
    ' Объединять.
    ws.Cells(3, 10).value = "нет"
    ' Служебный.
    ws.Cells(3, 11).value = "Не проверять"
    ' Уникальность.
    ws.Cells(3, 12).value = ""
    ' Доп. параметры.
    ' Эта строка также полностью корректна.

    wb.SaveAs fileName:=stepPath2 & "\step_01_attributes.xlsx", FileFormat:=xlOpenXMLWorkbook
    ' Сохраняем файл атрибутов Шага 1 во вторую папку.
    ' Имя файла соответствует ожидаемой схеме имён шаговых файлов.

    wb.Close SaveChanges:=False
    ' Закрываем книгу. SaveChanges:=False — мы уже всё сохранили.

    Application.ScreenUpdating = True
    ' Включаем обновление экрана обратно (было отключено в начале).

    Application.DisplayAlerts = True
    ' Включаем системные предупреждения обратно.

    MsgBox "Тестовые данные для Mod_Assembler созданы!" & vbCrLf & _
           "Созданы файлы для ДВУХ шагов (00 и 01):" & vbCrLf & vbCrLf & _
           "Папка """ & stepPath & """:" & vbCrLf & _
           "1. step_00_types.xlsx (2 корректных / 3 с ошибками)" & vbCrLf & _
           "2. step_00_attributes.xlsx (2 корректных / 3 с ошибками)" & vbCrLf & vbCrLf & _
           "Папка """ & stepPath2 & """:" & vbCrLf & _
           "3. step_01_types.xlsx (2 корректных типа)" & vbCrLf & _
           "4. step_01_attributes.xlsx (2 корректных атрибута)", vbInformation
    ' Показываем пользователю сообщение об успехе: перечисляем все четыре
    ' созданных файла по двум папкам шагов.
End Sub
' Конец процедуры.
